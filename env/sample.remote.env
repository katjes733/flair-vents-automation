# "Remote" dev mode — connects directly to the shared NAS Postgres/Redis
# instances (the same ones tesla-powerwall-automation's and wake-on-lan's
# production deployments use) instead of local throwaway docker-compose
# containers. Use this when you have LAN access to the NAS (e.g. at home);
# use env/sample.env (local docker-compose mode) instead when you don't
# (e.g. on the road).
#
# Copy this file to .env and fill in the real values yourself — never commit
# real credentials. The CA cert referenced by DB_SSL_CA_PATH must be copied
# into THIS project's own postgres/certs/ directory (gitignored), not
# referenced from another project's directory, to avoid cross-project coupling.

DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=postgres
# Deliberately NOT the production schema (flair_vents_automation) — this app
# runs a control tick against real vent-position rows, so a remote-dev
# process and the deployed production process must never share a schema the
# way wake-on-lan's MAC-address list safely can.
DB_SCHEMA=flair_vents_automation_dev

DB_SSL=true
DB_SSL_CA_PATH=./postgres/certs/<nas-name>/ca.crt

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=fva:

ALLOWED_ORIGINS=http://localhost:5173

# HTTPS / TLS for the app itself — see env/sample.env for details.
SSL_ENABLED=false
SSL_KEY_PATH=ssl/key.pem
SSL_CERT_PATH=ssl/cert.pem

FLAIR_CLIENT_ID=
FLAIR_CLIENT_SECRET=
FLAIR_API_BASE_URL=https://api.flair.co
FLAIR_GRANT_MODE=client_credentials

TOKEN_ENCRYPTION_KEY=

CONTROL_LOOP_ENABLED=true
# Fails closed: unset (as here) or any value other than exactly "false" is
# treated as true. A missing env var must never be what lets a container
# start moving real vents — only an explicit DRY_RUN=false, combined with a
# handler actually present in system_settings.config.live_air_handler_ids,
# ever dispatches real commands. Left unset here deliberately.
# DRY_RUN=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
RECIPIENT_EMAIL=

LOG_LEVEL=debug
