# "Local" dev mode — throwaway Postgres/Redis started via `bun run docker:up`
# (see docker-compose.yml). Use this when you don't have LAN access to the
# NAS (e.g. on the road); use env/sample.remote.env instead when you do
# (e.g. at home), to develop directly against the shared NAS instances.
#
# PostgreSQL — in remote mode this is the shared NAS instance, database is
# always "postgres"; this app is isolated via its own schema (DB_SCHEMA), not
# a separate database.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=postgres
DB_SCHEMA=flair_vents_automation

# PostgreSQL TLS — enforced even for local dev, using a self-signed CA
# generated by `bun run generate-certs` (see scripts/generate-certs.sh).
DB_SSL=true
DB_SSL_CA_PATH=./postgres/certs/local/ca.crt

# Redis — reuses the same Redis instance tesla-powerwall-automation and
# wake-on-lan already run against on the NAS. Every key this app touches is
# prefixed fva: so it can't collide with rl:* (tesla) or wol:* (wake-on-lan).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=fva:

# CORS — comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173

# HTTPS / TLS for the app itself (recommended for self-hosted production
# deployments). Set SSL_ENABLED=true and provide paths to a certificate and
# private key.
SSL_ENABLED=true
SSL_KEY_PATH=ssl/key.pem
SSL_CERT_PATH=ssl/cert.pem

# Flair Developer API — leave blank until Phase 0; fill in your own
# credentials once you're ready to run live discovery. FLAIR_GRANT_MODE may
# be flipped to authorization_code or refresh_token once Phase 0 confirms
# which grant this account actually needs.
FLAIR_CLIENT_ID=
FLAIR_CLIENT_SECRET=
FLAIR_API_BASE_URL=https://api.flair.co
FLAIR_GRANT_MODE=client_credentials

# 32-byte hex key used to encrypt persisted Flair tokens at rest
# (enc:v1:<iv>:<tag>:<data> envelope — see tokenCrypto.ts). Generate one with:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Control loop
CONTROL_LOOP_ENABLED=true
# Fails closed everywhere except this local-dev default — see
# env/sample.remote.env for why remote mode leaves this unset instead.
DRY_RUN=true

# Bootstrap-seed value only, read once on first boot to create the initial
# system_settings row — system_settings.config.home_timezone is what's
# actually authoritative after that. Placeholder value; confirm at kickoff.
HOME_TIMEZONE=America/Phoenix

# SMTP — email alerting (fail-safe, degraded vent, stale sensor, token
# budget, etc.). No user model yet, so every alert goes to RECIPIENT_EMAIL.
SMTP_HOST=
SMTP_PORT=587
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
RECIPIENT_EMAIL=

LOG_LEVEL=debug
